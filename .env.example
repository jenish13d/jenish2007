# =============================================================================
# StreamLounge environment configuration
# =============================================================================
# Copy to .env.local for local development:
#
#     cp .env.example .env.local
#
# In production set these in your hosting provider's dashboard. Never commit a
# file containing real values — .gitignore excludes .env and .env*.local.
#
# No value below is a working credential. Every one is a placeholder.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Application URL                                                  REQUIRED
# -----------------------------------------------------------------------------
# Canonical base URL. Used to build the OBS browser-source URL and the YouTube
# OAuth redirect. It is read from configuration only, never from request
# headers, so a wrong value here produces a visibly wrong URL rather than a
# host-header injection.
#
#   Local:      http://localhost:3000
#   Production: https://your-domain.com   (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. Supabase                                                         REQUIRED
# -----------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Reaches the browser by design; every query it
# makes is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SERVER ONLY. Bypasses Row Level Security entirely.
#
# Needed by three paths that have no user session and so cannot be authorised
# by RLS: the Razorpay webhook (no cookies), the OBS overlay event endpoint
# (authorised by the creator's overlay key), and viewer submission insertion
# (after the server has verified the payment with Razorpay).
#
# It must never be exposed to the browser. It has no NEXT_PUBLIC_ prefix, which
# is what keeps it out of the client bundle, and lib/supabase/service.ts throws
# if it is ever imported in a browser context.
#
# Without this, viewer submissions and webhook recovery will fail.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
# 3. Razorpay                                                         REQUIRED
# -----------------------------------------------------------------------------
# Razorpay dashboard -> Settings -> API Keys

# Key ID. Public by design: Razorpay Checkout needs it in the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SERVER ONLY. Signs and verifies checkout signatures and authenticates calls
# to the Razorpay API.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# SERVER ONLY. Razorpay dashboard -> Settings -> Webhooks.
#
#   Webhook URL:    https://your-domain.com/api/payments/webhook
#   Active events:  payment.captured, order.paid
#
# Check the endpoint's configuration with:
#   curl https://your-domain.com/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret


# -----------------------------------------------------------------------------
# 4. Signing secrets                                                  REQUIRED
# -----------------------------------------------------------------------------
# Two independent HMAC keys. Both are required, both must be at least 32
# characters, and neither has a fallback.
#
# The previous implementation derived these from RAZORPAY_KEY_SECRET and, if
# that was also missing, from a string literal in the source. A deployment with
# neither configured still produced tokens that verified — against a key
# published in the repository's history. Both are now mandatory, and the
# relevant operation fails closed when one is absent.
#
# Generate each one separately:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Do not reuse one value for both. They sign different capabilities, and
# separating them means a token from one subsystem cannot be replayed into the
# other.

# Signs the short-lived tokens that authorise an OBS overlay to report playback.
OVERLAY_SIGNING_SECRET=generate-64-hex-characters-see-above

# Signs the short-lived tokens that prove a viewer's payment was captured.
PAYMENT_SIGNING_SECRET=generate-a-different-64-hex-characters


# -----------------------------------------------------------------------------
# 5. OpenAI                                              OPTIONAL per feature
# -----------------------------------------------------------------------------
# Used by /api/tts (alert text read aloud) and /api/stickers/generate (AI
# stickers). Both endpoints require a verified payment and consume a single-use
# claim per payment, so one payment cannot be replayed for repeated billable
# generations.
#
# Leave unset to run without those two interaction types; the rest of the
# product works, and the endpoints return a clear "not configured" response.
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# 6. Google / YouTube OAuth                                          OPTIONAL
# -----------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
#
# Scope requested: youtube.readonly only. StreamLounge displays channel details
# and reads live chat; it never writes to a channel.
#
# Authorised redirect URIs:
#   Local:      http://localhost:3000/api/auth/youtube/callback
#   Production: https://your-domain.com/api/auth/youtube/callback
#
# Leave unset to run without channel connection and the live chat panel.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
